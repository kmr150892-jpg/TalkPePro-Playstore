{
  "expo": {
    "name": "TalkPe Pro",
    "slug": "TalkPe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talkpe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talkpe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "TalkPe Pro requires camera access to enable professional one-on-one video calls and interactive live sessions.",
        "NSMicrophoneUsageDescription": "TalkPe Pro requires microphone access for seamless audio communication during expert sessions and social gaming."
      }
    },
    "android": {
      "package": "com.talkpe.app",
      "versionCode": 14,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#020617"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "./plugins/withNotifeeRepo",
      "./plugins/withFirebaseNotifColor",
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-ok.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TalkPe Pro to access your gallery to update your professional profile picture."
        }
      ],
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/ringtone.mp3", "./assets/sounds/message.mp3"],
          "color": "#6366F1"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8998b989-95f7-4559-a6e1-a43ca339d4d1"
      }
    },
    "owner": "kmr123"
  }
}