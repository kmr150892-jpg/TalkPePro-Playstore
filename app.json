{
  "expo": {
    "name": "TalkPe Pro",
    "slug": "TalkPe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talkpe",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-ok.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talkpe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "TalkPe Pro requires camera access to enable professional one-on-one video consultations and interactive live sessions.",
        "NSMicrophoneUsageDescription": "TalkPe Pro requires microphone access for seamless audio communication during expert sessions and social gaming."
      }
    },
    "android": {
      "package": "com.talkpe.app",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#020617"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TalkPe Pro to access your gallery to update your professional profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8998b989-95f7-4559-a6e1-a43ca339d4d1"
      }
    },
    "owner": "kmr123"
  }
}